import { chromium } from 'playwright';
import { readFile } from 'node:fs/promises';

/**
 * Run only against the production HTML generated by scripts/build.mts.
 * This catches syntax errors in external dependencies bundled into inline scripts,
 * as well as broken application startup that TypeScript alone cannot detect.
 */
const markup = await readFile('dist/index.html', 'utf8');
if (!markup.includes('<script type="module">')) {
  throw new Error('Compiled application script must use type="module" for import.meta');
}

const server = Bun.serve({
  hostname: '127.0.0.1',
  port: 0,
  fetch(request) {
    const path = new URL(request.url).pathname;
    if (path !== '/' && path !== '/index.html') {
      return new Response('Not found', { status: 404 });
    }
    return new Response(markup, {
      headers: { 'content-type': 'text/html; charset=utf-8' }
    });
  }
});
const browser = await chromium.launch({ headless: true });
try {
  const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });
  const errors: string[] = [];
  page.on('pageerror', error => errors.push(error.message));
  await page.goto('http://127.0.0.1:' + server.port + '/', { waitUntil: 'load' });
  await page.waitForFunction(() =>
    document.querySelector('#document-name')?.textContent === 'SONAR / MOXA / PSU',
    { timeout: 15000 }
  );
  await page.locator('#editor-canvas').waitFor({ state: 'visible' });
  const state = await page.evaluate(() => {
    const canvas = document.querySelector<HTMLCanvasElement>('#editor-canvas');
    const status = document.querySelector('#status')?.textContent ?? '';
    return { width: canvas?.width ?? 0, height: canvas?.height ?? 0, status };
  });
  if (state.width < 300 || state.height < 150) {
    throw new Error('Canvas did not initialise: ' + JSON.stringify(state));
  }
  if (!state.status.includes('3 blocks') || !state.status.includes('7 cables')) {
    throw new Error('Editor did not load the sample document: ' + JSON.stringify(state));
  }
  await page.getByRole('button', { name: 'Block', exact: true }).click();
  await page.locator('#editor-canvas').click({ position: { x: 230, y: 250 } });
  await page.waitForFunction(() => (document.querySelector('#status')?.textContent ?? '').includes('4 blocks'));
  if (errors.length > 0) throw new Error('Browser runtime errors:\n' + errors.join('\n'));
  console.log('Production HTML browser boot and editing smoke passed.');
} finally {
  await browser.close();
  server.stop(true);
}
