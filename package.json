{
  "name": "wiring-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run build && bunx http-server dist -c-1",
    "typecheck": "tsc --noEmit",
    "guard": "bun scripts/guard.mts",
    "test": "bun test test",
    "validate": "bun run typecheck && bun run guard && bun run test",
    "build": "bun run validate && bun scripts/build.mts",
    "audit:mobile": "bun vendor/pages/src/cli.ts audit-mobile dist"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.54",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.14",
    "playwright": "^1.55.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
